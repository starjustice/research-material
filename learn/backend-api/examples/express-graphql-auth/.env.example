# Copy this file to .env before running anything.
# SQLite file lives at the project root. Zero setup.
DATABASE_URL="file:./dev.db"

# Signs every access token. If this leaks, anyone can forge logins.
# Generate a real one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="dev-only-change-me-to-a-long-random-string"

PORT=4000
