{
  "name": "express-graphql-auth",
  "private": true,
  "version": "1.0.0",
  "description": "Minimal notes app: Express 5 + GraphQL Yoga + Prisma 7 (SQLite) with JWT auth done properly",
  "type": "module",
  "scripts": {
    "setup": "prisma migrate dev --name init && prisma generate",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.13.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.0.0",
    "prisma": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
